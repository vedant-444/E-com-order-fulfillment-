{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run Master ETL Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/etl/pipeline.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "2. Launch Web MVP Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PORT": "5000"
            }
        },
        {
            "name": "3. Run Automated Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_tests.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
